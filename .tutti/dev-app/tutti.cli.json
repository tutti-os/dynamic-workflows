{
  "schemaVersion": "tutti.app.cli.v1",
  "scope": "dynamic-workflows",
  "description": "Create, configure, inspect, and run persistent tutti.flow.v1 Bundles.",
  "documentation": {
    "file": "COMMANDS.md"
  },
  "commands": [
    {
      "path": [
        "status"
      ],
      "summary": "Show runtime status",
      "description": "Report Flow and agent availability.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/status"
      }
    },
    {
      "path": [
        "agents"
      ],
      "summary": "List agent targets",
      "description": "List locally available Agent targets.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/agents"
      }
    },
    {
      "path": [
        "list"
      ],
      "summary": "List Flows",
      "description": "List persistent Flows with Cycle, Tick, lifecycle, and Schedule state.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "description": "Maximum number of Flows to return."
          }
        }
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/list"
      }
    },
    {
      "path": [
        "show"
      ],
      "summary": "Show one Flow",
      "description": "Return Bundle metadata, graph, configuration, current Cycle, and history.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workflow-id": {
            "type": "string",
            "description": "Flow id."
          },
          "include-script": {
            "type": "boolean",
            "description": "Include all Bundle source files."
          }
        },
        "required": [
          "workflow-id"
        ]
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/show"
      }
    },
    {
      "path": [
        "validate"
      ],
      "summary": "Validate a Flow Bundle",
      "description": "Statically validate a standalone tutti.flow.v1 Bundle without executing code nodes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "directory": {
            "type": "string",
            "description": "Bundle directory containing flow.js."
          }
        },
        "required": [
          "directory"
        ]
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/validate"
      }
    },
    {
      "path": [
        "create"
      ],
      "summary": "Launch Flow authoring",
      "description": "Launch an Agent that produces, reviews, and submits a standalone Flow Bundle.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "description": "Natural-language Flow request."
          },
          "agent": {
            "type": "string",
            "description": "Authoring Agent target id."
          },
          "model": {
            "type": "string",
            "description": "Optional authoring model."
          },
          "cwd": {
            "type": "string",
            "description": "Optional runtime project directory."
          }
        },
        "required": [
          "prompt"
        ]
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/create"
      }
    },
    {
      "path": [
        "import"
      ],
      "summary": "Import a Flow Bundle",
      "description": "Save a standalone Bundle as a new persistent Flow.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "directory": {
            "type": "string",
            "description": "Bundle directory containing flow.js."
          },
          "params": {
            "type": "string",
            "description": "JSON object containing initial Params."
          },
          "cwd": {
            "type": "string",
            "description": "Project directory used by code nodes."
          },
          "secret-bindings": {
            "type": "string",
            "description": "JSON object mapping Secrets to environment variable names."
          },
          "publish": {
            "type": "boolean",
            "description": "Publish the imported Version."
          },
          "activate": {
            "type": "boolean",
            "description": "Activate the Flow after import."
          }
        },
        "required": [
          "directory"
        ]
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/import"
      }
    },
    {
      "path": [
        "run"
      ],
      "summary": "Dispatch a Flow Tick",
      "description": "Start a Cycle or resume the active Cycle and queue one durable Tick.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workflow-id": {
            "type": "string",
            "description": "Flow id."
          },
          "inputs": {
            "type": "string",
            "description": "JSON object containing immutable Cycle Inputs."
          },
          "idempotency-key": {
            "type": "string",
            "description": "Optional caller idempotency key."
          },
          "agent": {
            "type": "string",
            "description": "Default Agent target for Agent nodes."
          },
          "model": {
            "type": "string",
            "description": "Default Agent model."
          },
          "permission-mode": {
            "type": "string",
            "description": "Default Agent permission mode."
          },
          "cwd": {
            "type": "string",
            "description": "Runtime project directory override."
          }
        },
        "required": [
          "workflow-id"
        ]
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/run"
      }
    },
    {
      "path": [
        "configure"
      ],
      "summary": "Configure a Flow",
      "description": "Update Params, project cwd, and Secret environment bindings.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workflow-id": {
            "type": "string",
            "description": "Flow id."
          },
          "params": {
            "type": "string",
            "description": "JSON object containing Params."
          },
          "expected-params-revision": {
            "type": "integer",
            "description": "Optimistic Params revision."
          },
          "cwd": {
            "type": "string",
            "description": "Project directory used by code nodes."
          },
          "secret-bindings": {
            "type": "string",
            "description": "JSON Secret binding object."
          }
        },
        "required": [
          "workflow-id"
        ]
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/configure"
      }
    },
    {
      "path": [
        "activate"
      ],
      "summary": "Activate a Flow",
      "description": "Set the Flow lifecycle to active.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workflow-id": {
            "type": "string",
            "description": "Flow id."
          }
        },
        "required": [
          "workflow-id"
        ]
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/activate"
      }
    },
    {
      "path": [
        "pause"
      ],
      "summary": "Pause a Flow",
      "description": "Set the Flow lifecycle to paused.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workflow-id": {
            "type": "string",
            "description": "Flow id."
          }
        },
        "required": [
          "workflow-id"
        ]
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/pause"
      }
    },
    {
      "path": [
        "cancel-cycle"
      ],
      "summary": "Cancel a Cycle",
      "description": "Request cancellation and run matching Finally nodes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workflow-id": {
            "type": "string",
            "description": "Flow id."
          },
          "cycle-id": {
            "type": "string",
            "description": "Optional Cycle id."
          },
          "run-id": {
            "type": "string",
            "description": "Optional Tick id used to resolve its Cycle."
          }
        },
        "required": [
          "workflow-id"
        ]
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/cancel-cycle"
      }
    },
    {
      "path": [
        "runs",
        "get"
      ],
      "summary": "Inspect a Tick",
      "description": "Return its Cycle checkpoint, Attempts, Effects, and Human tasks.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "run-id": {
            "type": "string",
            "description": "Tick id."
          }
        },
        "required": [
          "run-id"
        ]
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/runs/get"
      }
    },
    {
      "path": [
        "runs",
        "wait"
      ],
      "summary": "Wait for a Tick stop point",
      "description": "Durably wait until a Tick stops or asks for Human input.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "run-id": {
            "type": "string",
            "description": "Tick id."
          }
        },
        "required": [
          "run-id"
        ]
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/runs/wait"
      },
      "execution": {
        "mode": "wait"
      }
    },
    {
      "path": [
        "runs",
        "respond"
      ],
      "summary": "Respond to a Human node",
      "description": "Resolve a pending Human task and queue the next Tick.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "run-id": {
            "type": "string",
            "description": "Tick id."
          },
          "task-id": {
            "type": "string",
            "description": "Human task id."
          },
          "action": {
            "type": "string",
            "description": "Selected action id."
          },
          "values": {
            "type": "string",
            "description": "JSON object containing action field values."
          },
          "revision": {
            "type": "integer",
            "description": "Optional optimistic task revision."
          }
        },
        "required": [
          "run-id",
          "task-id",
          "action"
        ]
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/runs/respond"
      }
    },
    {
      "path": [
        "blueprints",
        "list"
      ],
      "summary": "List Blueprints",
      "description": "List standalone Flow Bundle templates.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/blueprints/list"
      }
    },
    {
      "path": [
        "blueprints",
        "search"
      ],
      "summary": "Search Blueprints",
      "description": "Search templates by scenario, tag, category, and capability.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search text."
          },
          "category": {
            "type": "string",
            "description": "Blueprint category."
          },
          "tags": {
            "type": "string",
            "description": "Comma-separated tags."
          },
          "requires-cwd": {
            "type": "boolean",
            "description": "Filter by project requirement."
          },
          "include-script": {
            "type": "boolean",
            "description": "Include Bundle files."
          },
          "limit": {
            "type": "integer",
            "description": "Maximum result count."
          }
        }
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/blueprints/search"
      }
    },
    {
      "path": [
        "blueprints",
        "get"
      ],
      "summary": "Get a Blueprint",
      "description": "Return one Flow Bundle template.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "blueprint-id": {
            "type": "string",
            "description": "Blueprint id."
          },
          "include-script": {
            "type": "boolean",
            "description": "Include Bundle files."
          }
        },
        "required": [
          "blueprint-id"
        ]
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/blueprints/get"
      }
    },
    {
      "path": [
        "blueprints",
        "instantiate"
      ],
      "summary": "Instantiate a Blueprint",
      "description": "Copy a complete Blueprint Bundle into a new independent Flow.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "blueprint-id": {
            "type": "string",
            "description": "Blueprint id."
          },
          "name": {
            "type": "string",
            "description": "Optional Flow name override."
          }
        },
        "required": [
          "blueprint-id"
        ]
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/blueprints/instantiate"
      }
    },
    {
      "path": [
        "authoring",
        "validate"
      ],
      "summary": "Validate an authored Bundle",
      "description": "Validate draft.flow and optionally start an independent semantic review.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "job-id": {
            "type": "string",
            "description": "Authoring job id."
          },
          "directory": {
            "type": "string",
            "description": "Bundle directory inside the authoring workspace."
          },
          "review-mode": {
            "type": "string",
            "description": "Either \"none\" or \"agent\"."
          },
          "reviewer-agent": {
            "type": "string",
            "description": "Optional independent reviewer Agent."
          },
          "reviewer-model": {
            "type": "string",
            "description": "Optional reviewer model."
          }
        },
        "required": [
          "job-id",
          "directory"
        ]
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/authoring/validate"
      }
    },
    {
      "path": [
        "authoring",
        "review",
        "get"
      ],
      "summary": "Get semantic review",
      "description": "Read the current review bound to an authored Bundle.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "job-id": {
            "type": "string",
            "description": "Authoring job id."
          }
        },
        "required": [
          "job-id"
        ]
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/authoring/review/get"
      }
    },
    {
      "path": [
        "authoring",
        "review",
        "wait"
      ],
      "summary": "Wait for semantic review",
      "description": "Durably wait for the independent review to stop.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "job-id": {
            "type": "string",
            "description": "Authoring job id."
          }
        },
        "required": [
          "job-id"
        ]
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/authoring/review/wait"
      },
      "execution": {
        "mode": "wait"
      }
    },
    {
      "path": [
        "authoring",
        "submit"
      ],
      "summary": "Submit an authored Bundle",
      "description": "Persist the exact reviewed Bundle as a new published Version.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "job-id": {
            "type": "string",
            "description": "Authoring job id."
          },
          "directory": {
            "type": "string",
            "description": "Bundle directory inside the authoring workspace."
          },
          "skip-semantic-review": {
            "type": "boolean",
            "description": "Explicitly waive independent review."
          },
          "reason": {
            "type": "string",
            "description": "Required audit reason when review is waived."
          }
        },
        "required": [
          "job-id",
          "directory"
        ]
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/authoring/submit"
      }
    },
    {
      "path": [
        "resume"
      ],
      "summary": "Resume a waiting Flow",
      "description": "Queue the next Tick for the active Cycle associated with a prior Tick.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workflow-id": {
            "type": "string",
            "description": "Flow id."
          },
          "run-id": {
            "type": "string",
            "description": "Prior Tick id."
          }
        },
        "required": [
          "workflow-id",
          "run-id"
        ]
      },
      "output": {
        "defaultMode": "json",
        "json": true
      },
      "handler": {
        "kind": "http",
        "method": "POST",
        "path": "/tutti/cli/resume"
      }
    }
  ]
}
